{
  "name": "sitech",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev --workspace @sitech/api\" \"npm run dev --workspace @sitech/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @sitech/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
